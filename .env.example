# HTTP server
PORT=3000

# PostgreSQL
# ค่าเริ่มต้นนี้ใช้กับ service `postgres` ใน docker-compose.yml
DATABASE_URL="postgresql://postgres:rootpassword123@localhost:5433/ecommerce_db"

# Authentication
# เปลี่ยนเป็นค่าแบบสุ่มที่ยาวและเก็บเป็นความลับเสมอเมื่อ deploy จริง
JWT_SECRET="replace-this-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
